{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Raftaar",
  "version": "0.2.0",
  "identifier": "com.raftaar.optimizer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Raftaar",
        "width": 1180,
        "height": 700,
        "minWidth": 940,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/presentmon"],
    "shortDescription": "Safe, honest PC game optimizer",
    "copyright": "Raftaar. PresentMon (c) Intel Corporation, MIT License.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
